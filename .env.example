# KTMB KITS Login Credentials (Required for booking)
KTM_EMAIL=your_ktmb_email@example.com
KTM_PASSWORD=your_ktmb_password

TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# SQLite Database path
KTM_DB_PATH=data/ktm_sniper.db

# Passenger PII (optional fallback if not in tasks.json)
KTM_PASSENGER_IC=900101-14-5566
KTM_PASSENGER_PHONE=+60123456789

# Headless & Polling Configuration
KTM_HEADLESS=true
POLL_INTERVAL=4.5
POLL_JITTER=1.5
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT=15.0
